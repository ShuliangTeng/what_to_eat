# Copy this file to .env.local and fill in your own Supabase project.
# Never put the service role key here. The browser only receives NEXT_PUBLIC_ values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use the publishable key from the Supabase dashboard.
# The legacy anon key also works if that is what your project shows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
